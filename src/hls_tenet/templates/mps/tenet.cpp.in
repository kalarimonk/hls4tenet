#define AP_INT_MAX_W 2048

#include <ap_int.h>
#include <ap_fixed.h>
#include "./hls_tensor.h"
#include "./hls_contraction.h"
#include "./hls_tenet.h"
#include "./hls_weights.h"
#include <inttypes.h>

#include <ap_int.h>

using namespace std;

void run_tenet( hls::stream<ap_uint<BITS_PACKED>>& features, hls::stream<tensor_t> predictions[LABEL_DIM])
{

#pragma HLS INTERFACE mode=ap_ctrl_none port=return

#pragma HLS PIPELINE II=1

#pragma HLS ARRAY_PARTITION variable=predictions complete dim=0

#pragma HLS INTERFACE axis port = features
#pragma HLS INTERFACE axis port = predictions

	tensor_t in_data[NUM_FEATURES][PHY_BOND_DIM];      // Number of features is the same as number of sites/nodes in the MPS

#pragma HLS ARRAY_PARTITION variable=in_data complete dim=0

    tensor_t l_env[MAX_BOND_DIM];
    tensor_t r_env[MAX_BOND_DIM];

    tensor_t l_next[MAX_BOND_DIM];
    tensor_t r_next[MAX_BOND_DIM];

#pragma HLS ARRAY_PARTITION variable=l_env complete dim=0
#pragma HLS ARRAY_PARTITION variable=l_next complete dim=0
#pragma HLS ARRAY_PARTITION variable=r_env complete dim=0
#pragma HLS ARRAY_PARTITION variable=r_next complete dim=0

	tensor_t label_node[LABEL_DIM];

#pragma HLS ARRAY_PARTITION variable=label_node complete dim=0

	bool not_empty_features = 1;
	ap_uint<BITS_PACKED> packed_feature;


	chek_empty: not_empty_features &= (!features.empty());

	if (not_empty_features){
		packed_feature = features.read();
		int index = 0;
		for (int i = 0; i < NUM_FEATURES; ++i) {
			for (int j = 0; j < PHY_BOND_DIM; ++j) {
				ap_uint<PRECISION> raw_bits = packed_feature.range(index + PRECISION - 1, index);
				in_data[i][j].range(PRECISION - 1, 0) = raw_bits;  // assign bits directly
				index += PRECISION;
			}
		}
	}

	if(not_empty_features) {

		
		__START_LEFTMOST_KERNELS__
		//Left Most Site Contractions
		left_boundary_contraction<__LEFT_DIM__, __RIGHT_DIM__,__PHY_DIM__>(in_data[__ID__], site__ID__, l_env);
		__LEFTMOST_KERNELS_END__
		__START_CALL_LEFT_ENV_KERNELS__
		//Left Environment Contractions
		lenv_rank3_tensor_contraction<__LEFT_DIM__,__RIGHT_DIM__,__PHY_DIM__>(l_env, in_data[__ID__], site__ID__, l_next);			
		update_lenv__ID__: for(int i=0; i< __RIGHT_DIM__ ;i++){
			l_env[i] = l_next[i];
		}
		__CALL_LEFT_ENV_KERNELS_END__
		
		__START_RIGHTMOST_KERNELS__
		//Right Most Site Contractions
		right_boundary_contraction<__LEFT_DIM__, __RIGHT_DIM__,__PHY_DIM__>(in_data[__ID__], site__ID__, r_env);
		__RIGHTMOST_KERNELS_END__
		__START_CALL_RIGHT_ENV_KERNELS__
		renv_rank3_tensor_contraction<__LEFT_DIM__,__RIGHT_DIM__,__PHY_DIM__>(r_env, in_data[__ID__], site__ID__, r_next);			
		update_renv__ID__: for(int i=0; i< __LEFT_DIM__ ;i++){
			r_env[i] = r_next[i];
		}
		__CALL_RIGHT_ENV_KERNELS_END__


		// Label site contraction
		__LABEL_KERNEL_START__
		rank4_tensor_contraction<__LEFT_DIM__,__RIGHT_DIM__,__PHY_DIM__,__LABEL_DIM__>(l_env, r_next, in_data[__LABEL_SITE_ID__], label_site, label_node);
		__LABEL_KERNEL_END__

		write_predictions: for (int p = 0; p < LABEL_DIM; p++){
			predictions[p].write(label_node[p]);
		}

    }

}





