[hls]
flow_target=vivado
package.output.format=ip_catalog
package.output.syn=false
syn.top=run_tenet
clock=16ns
csim.code_analyzer=0
tb.file= __OUTPUT_DIR__/tenet_tb.cpp
syn.file= __OUTPUT_DIR__/hls_tenet.cpp
syn.file= __OUTPUT_DIR__/hls_contraction.h
syn.file= __OUTPUT_DIR__/hls_tensor.h
syn.file= __OUTPUT_DIR__/hls_weights.h
syn.file= __OUTPUT_DIR__/hls_tenet.h
syn.file= __OUTPUT_DIR__/hls_dispatcher.h
syn.file= __OUTPUT_DIR__/hls_dispatcher.cpp
csim.clean=1
csim.sanitize_address=0
csim.sanitize_undefined=0
csim.argv=<tb_data_path> <result_file_path>
